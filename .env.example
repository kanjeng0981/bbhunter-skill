# Copy to .env and fill in.

# --- LLM (any OpenAI-compatible endpoint) ---
BBHUNTER_LLM_BASE_URL=http://llm.lightvela.ai/v1
BBHUNTER_LLM_API_KEY=
BBHUNTER_LLM_MODEL=deepseek-chat
BBHUNTER_LLM_TIMEOUT=120

# --- Output & skills ---
BBHUNTER_OUTPUT_DIR=reports
BBHUNTER_SKILLS_DIR=skills

# --- Web3 ---
BBHUNTER_RPC_URL=https://eth.llamarpc.com
BBHUNTER_ETHERSCAN_API_KEY=

# --- HTTP ---
BBHUNTER_HTTP_TIMEOUT=15
BBHUNTER_USER_AGENT=bbhunter/0.1 (+bug bounty research)
